{
  "name": "catalystops",
  "displayName": "CatalystOps - PySpark Optimizer",
  "description": "Analyze PySpark code for performance issues using Catalyst execution plan analysis",
  "version": "0.9.2",
  "publisher": "CatalystOps",
  "repository": {
    "type": "git",
    "url": "https://github.com/lezwon/CatalystOps"
  },
  "homepage": "https://catalystops.dev/",
  "license": "Elastic-2.0",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "pyspark",
    "spark",
    "databricks",
    "optimization",
    "catalyst"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onView:catalystops.issuesTree",
    "onView:catalystops.billingTree",
    "onView:catalystops.explainTree",
    "onView:catalystops.jobsTree",
    "onView:catalystops.clustersTree",
    "onNotebook:jupyter-notebook"
  ],
  "main": "./out/vscode/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "catalystops.analyzeCost",
        "title": "CatalystOps: Analyze Cost (Dry Run)"
      },
      {
        "command": "catalystops.analyzeSelection",
        "title": "CatalystOps: Analyze Selected Code"
      },
      {
        "command": "catalystops.showReport",
        "title": "CatalystOps: Show Report"
      },
      {
        "command": "catalystops.configureConnection",
        "title": "CatalystOps: Configure Databricks Connection"
      },
      {
        "command": "catalystops.showGeneratedScript",
        "title": "CatalystOps: Show Generated Script"
      },
      {
        "command": "catalystops.previewDryRunScript",
        "title": "CatalystOps: Preview Dry-Run Script"
      },
      {
        "command": "catalystops.previewFullDryRunScript",
        "title": "CatalystOps: Preview Full Dry-Run Script (with wrapper)"
      },
      {
        "command": "catalystops.showFullDryRunScript",
        "title": "CatalystOps: Show Full Script from Last Dry Run"
      },
      {
        "command": "catalystops.showBillingDashboard",
        "title": "CatalystOps: Show Billing Dashboard",
        "icon": "$(graph)"
      },
      {
        "command": "catalystops.refreshBilling",
        "title": "CatalystOps: Refresh Billing Data",
        "icon": "$(refresh)"
      },
      {
        "command": "catalystops.refreshJobs",
        "title": "CatalystOps: Refresh Jobs List",
        "icon": "$(refresh)"
      },
      {
        "command": "catalystops.analyzeJobRun",
        "title": "CatalystOps: Analyze Job Run",
        "icon": "$(search)"
      },
      {
        "command": "catalystops.refreshClusters",
        "title": "CatalystOps: Refresh Clusters",
        "icon": "$(refresh)"
      },
      {
        "command": "catalystops.connectClusterSsh",
        "title": "Connect via SSH",
        "icon": "$(remote)"
      },
      {
        "command": "catalystops.stopCluster",
        "title": "Stop Cluster",
        "icon": "$(debug-stop)"
      },
      {
        "command": "catalystops.clearSshAlias",
        "title": "Reset SSH Host",
        "icon": "$(trash)"
      },
      {
        "command": "catalystops.jobItemClicked",
        "title": "Analyze Job Run (double-click)"
      },
      {
        "command": "catalystops.showPlanDag",
        "title": "CatalystOps: Show Plan DAG",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "catalystops.jumpToLine",
        "title": "CatalystOps: Jump to Source Line"
      },
      {
        "command": "catalystops.quickfix.broadcastHint",
        "title": "Add Broadcast Hint",
        "icon": "$(broadcast)"
      },
      {
        "command": "catalystops.quickfix.repartition",
        "title": "Add Repartition",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "catalystops.quickfix.persist",
        "title": "Add Persist",
        "icon": "$(database)"
      },
      {
        "command": "catalystops.quickfix.aqeConfig",
        "title": "Enable AQE",
        "icon": "$(settings-gear)"
      },
      {
        "command": "catalystops.quickfix.addJoinCondition",
        "title": "Add Join Condition",
        "icon": "$(link)"
      }
    ],
    "keybindings": [
      {
        "command": "catalystops.analyzeCost",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k",
        "when": "editorTextFocus && editorLangId == python"
      }
    ],
    "configuration": [
      {
        "title": "Databricks: Connection",
        "properties": {
          "catalystops.databricks.host": {
            "type": "string",
            "default": "",
            "description": "Databricks workspace URL (e.g., https://myworkspace.cloud.databricks.com)"
          },
          "catalystops.databricks.authType": {
            "type": "string",
            "enum": ["pat", "azure-cli", "gcp-adc"],
            "enumDescriptions": [
              "Personal Access Token — use a PAT from the token field or ~/.databrickscfg",
              "Azure CLI — authenticate using your active `az login` session; no token required",
              "GCP ADC — authenticate using GCP Application Default Credentials (`gcloud auth application-default login`); no token required"
            ],
            "default": "pat",
            "description": "Authentication method. Use 'Configure Databricks Connection' command to set this automatically."
          },
          "catalystops.databricks.token": {
            "type": "string",
            "default": "",
            "when": "config.catalystops.databricks.authType == 'pat'",
            "description": "Databricks personal access token"
          },
          "catalystops.databricks.profile": {
            "type": "string",
            "default": "DEFAULT",
            "when": "config.catalystops.databricks.authType == 'pat'",
            "description": "Databricks CLI config profile name (from ~/.databrickscfg). Token is read from this profile."
          },
          "catalystops.databricks.configPath": {
            "type": "string",
            "default": "~/.databrickscfg",
            "when": "config.catalystops.databricks.authType == 'pat'",
            "description": "Path to the Databricks CLI config file"
          },
          "catalystops.databricks.clusterId": {
            "type": "string",
            "default": "",
            "description": "Interactive cluster ID for dry-run analysis. Leave blank to use serverless."
          },
          "catalystops.databricks.executionMode": {
            "type": "string",
            "enum": [
              "cluster",
              "serverless"
            ],
            "default": "cluster",
            "description": "Execution mode for dry-run analysis. 'cluster' requires a Cluster ID above. 'serverless' requires Databricks Premium tier."
          },
          "catalystops.dryRun.timeoutSeconds": {
            "type": "number",
            "default": 300,
            "minimum": 30,
            "description": "Maximum seconds to wait for a dry-run job to complete before cancelling."
          }
        }
      },
      {
        "title": "Databricks: Jobs",
        "properties": {
          "catalystops.jobs.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Show the Jobs sidebar panel with last-run status and plan analysis on historical runs."
          }
        }
      },
      {
        "title": "Databricks: Billing",
        "properties": {
          "catalystops.billing.warehouseId": {
            "type": "string",
            "default": "",
            "description": "SQL warehouse ID for billing queries. Leave empty to auto-select the first available warehouse."
          },
          "catalystops.cost.dbuRatePerHour": {
            "type": "number",
            "default": 0.4,
            "description": "DBU rate per hour for interactive cluster cost estimation (dollars)."
          },
          "catalystops.cost.serverlessRatePerHour": {
            "type": "number",
            "default": 0.7,
            "description": "Effective cost per hour for serverless runs (dollars)."
          },
          "catalystops.cost.queryBillingUsage": {
            "type": "boolean",
            "default": false,
            "description": "After each serverless dry run, query system.billing.usage to fetch real DBU consumption. Requires Unity Catalog System Tables. Billing data appears 1–5 minutes after run completion."
          }
        }
      },
      {
        "title": "Databricks: Clusters & SSH",
        "properties": {
          "catalystops.ssh.shutdownDelay": {
            "type": "string",
            "default": "30m",
            "description": "How long to keep the cluster alive after the SSH session closes (e.g. '10m', '1h'). Passed as --shutdown-delay to `databricks ssh setup`."
          },
          "catalystops.connection.sshTunnel.enabled": {
            "type": "boolean",
            "default": false,
            "description": "Use a Databricks SSH tunnel for script execution. Requires Databricks CLI ≥ 0.269 and `databricks ssh setup --name <name>` to be configured. DBR 17+ only."
          },
          "catalystops.connection.sshTunnel.connectionName": {
            "type": "string",
            "default": "",
            "description": "SSH connection name configured via `databricks ssh setup --name <name>`."
          }
        }
      },
      {
        "title": "Code Analysis",
        "properties": {
          "catalystops.analysis.autoAnalyzeOnSave": {
            "type": "boolean",
            "default": false,
            "description": "Automatically run local anti-pattern analysis when a PySpark file is saved."
          },
          "catalystops.analysis.enableLocalCodeAnalysis": {
            "type": "boolean",
            "default": true,
            "description": "Enable local anti-pattern detection (no cluster required)."
          },
          "catalystops.analysis.enableRepeatedScanDetection": {
            "type": "boolean",
            "default": false,
            "description": "Warn when the same source DataFrame is used multiple times without .cache() or .persist(). Disable if you see false positives in complex DAGs."
          }
        }
      },
      {
        "title": "General",
        "properties": {
          "catalystops.mcp.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable the CatalystOps MCP server for integration with Claude, Copilot, and other MCP clients. Restart VS Code after changing."
          },
          "catalystops.debug": {
            "type": "boolean",
            "default": false,
            "description": "Enable debug logging — prints curl-equivalent commands for every Databricks API call to the Output panel."
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "catalystops",
          "title": "CatalystOps",
          "icon": "media/icon-mono.svg"
        }
      ]
    },
    "views": {
      "catalystops": [
        {
          "id": "catalystops.issuesTree",
          "name": "Issues",
          "icon": "media/icon-mono.svg"
        },
        {
          "id": "catalystops.explainTree",
          "name": "Explain Plan",
          "icon": "media/icon-mono.svg"
        },
        {
          "id": "catalystops.billingTree",
          "name": "Billing",
          "icon": "media/icon-mono.svg",
          "when": "catalystops.databricksConfigured"
        },
        {
          "id": "catalystops.jobsTree",
          "name": "Jobs",
          "icon": "media/icon-mono.svg",
          "when": "catalystops.databricksConfigured"
        },
        {
          "id": "catalystops.clustersTree",
          "name": "Clusters",
          "icon": "media/icon-mono.svg",
          "when": "catalystops.databricksConfigured"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "catalystops.gettingStarted",
        "title": "Get started with CatalystOps",
        "description": "Optimize PySpark code and reduce Databricks costs — from instant local analysis to deep Catalyst plan inspection.",
        "steps": [
          {
            "id": "catalystops.gettingStarted.welcome",
            "title": "Welcome to CatalystOps",
            "description": "Two layers of analysis: instant local anti-pattern detection and deep Catalyst plan analysis via Databricks dry runs.",
            "media": {
              "markdown": "media/walkthrough/01-welcome.md"
            }
          },
          {
            "id": "catalystops.gettingStarted.localAnalysis",
            "title": "Instant Local Analysis",
            "description": "Open any PySpark file and CatalystOps immediately flags anti-patterns — cartesian joins, Python UDFs, missing cache, and 25+ more. No cluster needed.\n[Open the Issues Panel](command:catalystops.issuesTree.focus)",
            "media": {
              "markdown": "media/walkthrough/02-local-analysis.md"
            },
            "completionEvents": [
              "onView:catalystops.issuesTree"
            ]
          },
          {
            "id": "catalystops.gettingStarted.connect",
            "title": "Connect to Databricks",
            "description": "Configure your workspace URL, access token, and cluster ID (or choose serverless mode) to enable deep plan analysis.\n[Configure Connection](command:catalystops.configureConnection)",
            "media": {
              "markdown": "media/walkthrough/03-connect.md"
            },
            "completionEvents": [
              "onCommand:catalystops.configureConnection"
            ]
          },
          {
            "id": "catalystops.gettingStarted.dryRun",
            "title": "Run a Deep Analysis",
            "description": "Press **⌘⇧K** (macOS) or **Ctrl+Shift+K** to submit your code to Databricks, capture the Catalyst physical plan, and see cost-aware diagnostics.\n[Run Dry Run](command:catalystops.analyzeCost)",
            "media": {
              "markdown": "media/walkthrough/04-dry-run.md"
            },
            "completionEvents": [
              "onCommand:catalystops.analyzeCost"
            ]
          },
          {
            "id": "catalystops.gettingStarted.explainPlan",
            "title": "Explore the Execution Plan",
            "description": "After a dry run, inspect plan operators in the sidebar tree and open the visual DAG — click any node to jump to the source line.\n[Show Plan DAG](command:catalystops.showPlanDag)",
            "media": {
              "markdown": "media/walkthrough/05-explain-plan.md"
            },
            "completionEvents": [
              "onCommand:catalystops.showPlanDag"
            ]
          },
          {
            "id": "catalystops.gettingStarted.billing",
            "title": "Track Databricks Costs",
            "description": "See your DBU usage and spend broken down by cluster and job — pulled live from system.billing.usage.\n[Open Billing Dashboard](command:catalystops.showBillingDashboard)",
            "media": {
              "markdown": "media/walkthrough/06-billing.md"
            },
            "completionEvents": [
              "onCommand:catalystops.showBillingDashboard"
            ]
          },
          {
            "id": "catalystops.gettingStarted.jobs",
            "title": "Analyze Historical Job Runs",
            "description": "Inspect past Databricks job runs from the Jobs sidebar — no re-execution needed. CatalystOps reads Spark event logs to surface plan issues in an interactive DAG view.\n[Refresh Jobs](command:catalystops.refreshJobs)",
            "media": {
              "markdown": "media/walkthrough/08-jobs.md"
            },
            "completionEvents": [
              "onCommand:catalystops.analyzeJobRun"
            ]
          },
          {
            "id": "catalystops.gettingStarted.sshConnect",
            "title": "SSH into Databricks Clusters",
            "description": "Connect to any Databricks cluster directly from the Clusters sidebar — auto-starts stopped clusters, fixes access mode, and opens VS Code Remote SSH in one click.\n[Refresh Clusters](command:catalystops.refreshClusters)",
            "media": {
              "markdown": "media/walkthrough/09-ssh-connect.md"
            },
            "completionEvents": [
              "onCommand:catalystops.connectClusterSsh"
            ]
          },
          {
            "id": "catalystops.gettingStarted.mcp",
            "title": "AI Integration via MCP",
            "description": "CatalystOps exposes a local MCP server so Claude, GitHub Copilot, and other AI assistants can analyze your code, read plan results, and query billing data.",
            "media": {
              "markdown": "media/walkthrough/07-mcp.md"
            }
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "catalystops",
        "label": "CatalystOps"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "catalystops.showBillingDashboard",
          "when": "view == catalystops.billingTree",
          "group": "navigation"
        },
        {
          "command": "catalystops.refreshBilling",
          "when": "view == catalystops.billingTree",
          "group": "navigation"
        },
        {
          "command": "catalystops.showPlanDag",
          "when": "view == catalystops.explainTree",
          "group": "navigation"
        },
        {
          "command": "catalystops.refreshJobs",
          "when": "view == catalystops.jobsTree",
          "group": "navigation"
        },
        {
          "command": "catalystops.refreshClusters",
          "when": "view == catalystops.clustersTree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "catalystops.connectClusterSsh",
          "when": "view == catalystops.clustersTree && viewItem =~ /catalystops\\.clusterItem/",
          "group": "inline@1"
        },
        {
          "command": "catalystops.stopCluster",
          "when": "view == catalystops.clustersTree && viewItem == catalystops.clusterItem.running",
          "group": "inline@2"
        },
        {
          "command": "catalystops.clearSshAlias",
          "when": "view == catalystops.clustersTree && viewItem =~ /catalystops\\.clusterItem/",
          "group": "1_cluster@1"
        },
        {
          "command": "catalystops.quickfix.broadcastHint",
          "when": "view == catalystops.explainTree && viewItem =~ /^join-(sortmerge|shuffled|cartesian)/",
          "group": "inline"
        },
        {
          "command": "catalystops.quickfix.repartition",
          "when": "view == catalystops.explainTree && viewItem == exchange",
          "group": "inline"
        },
        {
          "command": "catalystops.quickfix.persist",
          "when": "view == catalystops.explainTree && viewItem == scan-repeated",
          "group": "inline"
        },
        {
          "command": "catalystops.quickfix.aqeConfig",
          "when": "view == catalystops.explainTree && viewItem == join-sortmerge",
          "group": "inline@2"
        },
        {
          "command": "catalystops.quickfix.addJoinCondition",
          "when": "view == catalystops.explainTree && viewItem == join-cartesian",
          "group": "inline@2"
        }
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@vscode/extension-telemetry": "^0.9.8",
    "zod": "^3.24.2"
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "node esbuild.js --production",
    "lint": "tsc --noEmit",
    "test": "npm run compile && ./node_modules/.bin/mocha 'out/test/suite/*.test.js' --ui tdd --timeout 10000 --reporter spec",
    "publish:vsce": "npx vsce publish",
    "publish:ovsx": "npx ovsx publish -p $OVSX_TOKEN",
    "publish:all": "npm run publish:vsce && npm run publish:ovsx",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:deploy": "npm run docs:build && cp -r docs/.vitepress/dist/. ../catalystops-web/docs/"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.19.11",
    "mocha": "^10.2.0",
    "typescript": "^5.3.3",
    "vitepress": "^1.6.4"
  }
}
