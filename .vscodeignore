# ── Dev tools & config ───────────────────────────────────────────────────────
.vscode/**
.vscode-test/**
.claude/**
tsconfig.json
esbuild.js
scripts/**
demo.py

# ── Source TypeScript (bundled by esbuild into out/vscode/extension.js) ──────
vscode/**
**/*.ts
**/*.map

# ── Tests ────────────────────────────────────────────────────────────────────
test/**

# ── Dependencies (bundled) ───────────────────────────────────────────────────
node_modules/**

# ── Compiled output — keep only the production bundle ────────────────────────
out/**
!out/vscode/extension.js

# ── Media — only the icons referenced in package.json ───────────────────────
media/**
!media/icon.png
!media/icon-mono.svg

# ── JetBrains plugin ─────────────────────────────────────────────────────────
jetbrains/**
.idea/**
*.iml

# ── Misc ─────────────────────────────────────────────────────────────────────
src/**
python/**
*.vsix
.gitignore
